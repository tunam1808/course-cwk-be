generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  fullName    String?
  role        Role         @default(USER)
  status      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  progress    Progress[]
  userCourses UserCourse[]
  scheduleAccess ScheduleAccess?
  scheduleFeedbacks ScheduleFeedback[]
  scheduleAttendances ScheduleAttendance[]
  scheduleMemberships ScheduleMember[]
  pushSubscriptions PushSubscription[]
  // Điểm đánh giá của chính user này (khi là học viên có quyền xem lịch)
  scoreLogs        StudentScoreLog[] @relation("StudentScoreLogs")
  // Các lượt chấm điểm mà user này (khi là admin) đã thực hiện cho người khác
  scoreLogsCreated StudentScoreLog[] @relation("ScoreLogCreatedBy")
  @@map("user")
}

model Course {
  id          Int            @id @default(autoincrement())
  title       String
  category    CourseCategory
  duration    Float?
  fileSize    Float?
  videoId     String?
  fileHash    String?
  uploadedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  progress    Progress[]
  order       Int?
  userCourses UserCourse[]
  @@map("course")
}

model Progress {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("progress")
}

model UserCourse {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("user_course")
}

model Intro {
  id        Int      @id @default(autoincrement())
  slot      Int      @unique // ← thêm mới: 1, 2, hoặc 3
  videoId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("intro")
}
model CountdownSetting {
  id         Int       @id @default(1)
  active     Boolean   @default(false)
  visible    Boolean   @default(false)
  startTime  DateTime?
  durationMs BigInt?
  updatedAt  DateTime  @updatedAt

  @@map("countdown_setting") 
}

model LuckySetting {
  id              Int     @id @default(1)
  showLuckyNumber Boolean @default(false)

  @@map("lucky_setting")
}
enum CourseCategory {
  CAPCUT_AI
  BAT_DONG_SAN
  MIEN_PHI
  MOBILE
}

enum Role {
  ADMIN
  USER
}

// ── CẤP 1: Folder gốc ───────────────────────────────────────────────
model ResourceCategory {
  id           Int                  @id @default(autoincrement())
  name         String
  slug         String               @unique
  order        Int                  @default(0)
  isVip        Boolean              @default(true)  // true = chỉ VIP, false = tất cả user
  thumbnailKey String?              // path trên Bunny, vd: "covers/uuid.jpg"
  thumbnailUrl String?              @db.Text
  subFolders   ResourceSubFolder[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("resource_category")
}

// ── CẤP 2: Folder con ───────────────────────────────────────────────
model ResourceSubFolder {
  id         Int              @id @default(autoincrement())
  name       String
  slug       String
  order      Int              @default(0)
  categoryId Int
  category   ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  files      ResourceFile[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("resource_sub_folder")
}

// ── CẤP 3: File tài nguyên ──────────────────────────────────────────
model ResourceFile {
  id            Int               @id @default(autoincrement())
  name          String
  description   String?
  subFolderId   Int
  subFolder     ResourceSubFolder @relation(fields: [subFolderId], references: [id], onDelete: Cascade)
  fileName      String            // tên file gốc khi upload
  fileKey       String            // full path trên Bunny, vd: "resources/nhac-nen/lo-fi/uuid.mp3"
  fileUrl       String            @db.Text
  fileSize      Int               // bytes
  mimeType      String
  fileType      ResourceFileType
  downloadCount Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([subFolderId])
  @@map("resource_file")
}

// ── Enum mới ─────────────────────────────────────────────────────────
enum ResourceFileType {
  MP3   // audio: mp3, wav, ogg, flac, aac
  MP4   // video: mp4, mov, avi, webm
  FONT  // font: ttf, otf, woff, woff2, zip
  IMAGE // image: gif, jpeg, jpg, png
  LUT   // lut màu: cube
  OTHER
}


// ── THỜI KHÓA BIỂU ──────────────────────────────────────────────────
model ScheduleItem {
  id        Int              @id @default(autoincrement())
  date      DateTime         @db.Date // ngày cụ thể của buổi — mỗi tuần có thể khác nhau
  session   ScheduleSession  // suy ra từ startTime lúc lưu, cache để query nhanh
  type      ScheduleType
  title     String
  startTime String           @db.VarChar(5) // "HH:mm"
  endTime   String           @db.VarChar(5) // "HH:mm"
  allTeam   Boolean          @default(false)
  // true khi đã gửi push nhắc "còn 1 tiếng nữa" cho buổi này — tránh gửi
  // trùng lặp mỗi lần cron quét lại. Reset về false khi ngày/giờ buổi bị sửa.
  notified1hBefore Boolean   @default(false)
  // true khi đã gửi nhắc "còn buổi chưa đánh giá" cho buổi này (gửi 1 lần
  // duy nhất, 30 phút sau khi buổi kết thúc, cho những ai lúc đó chưa nộp).
  notifiedFeedbackReminder Boolean @default(false)
  members   ScheduleMember[]
  feedbacks ScheduleFeedback[] 
  attendances ScheduleAttendance[]
  scoreLogs StudentScoreLog[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([date, session])
  @@map("schedule_item")
}

// Thành viên tham gia 1 buổi — liên kết tới tài khoản User thật (không còn
// là tên tự nhập), để có thể xác định chính xác gửi push notification cho
// đúng ai khi buổi không phải "cả team".
model ScheduleMember {
  id             Int          @id @default(autoincrement())
  scheduleItemId Int
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([scheduleItemId, userId])
  @@index([scheduleItemId])
  @@index([userId])
  @@map("schedule_member")
}


enum ScheduleSession {
  SANG
  CHIEU
  TOI
}

enum ScheduleType {
  HOC
  CHOI
}


// ── QUYỀN XEM THỜI KHÓA BIỂU ─────────────────────────────────────────
// Admin chỉ được chọn/nhập email của tài khoản ĐÃ TỒN TẠI trong bảng User
// (kiểm tra ở tầng controller trước khi tạo bản ghi này). type chỉ là
// nhãn để admin lọc/phân loại, không tự động ảnh hưởng quyền xem.
// Bảng này cũng đồng thời là danh sách "đủ điều kiện có điểm đánh giá" —
// chỉ ai có mặt ở đây mới được chấm điểm.

model ScheduleAccess {
  id        Int                @id @default(autoincrement())
  userId    Int                @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ScheduleAccessType @default(NORMAL)
  // Mức cảnh báo điểm đã gửi push gần nhất — dùng để chỉ gửi push khi mức độ
  // XẤU ĐI (VD từ NONE -> MILD, hoặc MILD -> SEVERE), tránh gửi lặp lại mỗi
  // lần bị trừ thêm điểm trong khi vẫn đứng yên ở cùng 1 mức. Khi điểm cải
  // thiện trở lại, mức này vẫn được cập nhật giảm xuống (âm thầm, không gửi
  // push "chúc mừng"), để nếu sau đó lại tụt xuống thì vẫn được cảnh báo tiếp.
  scoreWarningLevel ScoreWarningLevel @default(NONE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("schedule_access")
}

enum ScheduleAccessType {
  TEAM_MEMBER
  NORMAL
}

enum ScoreWarningLevel {
  NONE
  MILD   // điểm < 60: "Điểm của bạn đang thấp, cần cố gắng hơn"
  SEVERE // điểm < 40: "Bạn sắp bị bỏ lại phía sau rồi đó, cải thiện hơn nào"
}


// ── ĐÁNH GIÁ BUỔI HỌC / BUỔI ĐI CHƠI ─────────────────────────────────
// Mỗi user chỉ đánh giá 1 lần cho 1 buổi (unique scheduleItemId+userId).
// Form chỉ hiện khi buổi đã kết thúc >=30 phút, kiểm tra lại ở server khi nộp.
model ScheduleFeedback {
  id               Int          @id @default(autoincrement())
  scheduleItemId   Int
  scheduleItem     ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  userId           Int
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodScore        Int // 1-10: hôm nay vui không
  moodReason       String?      @db.Text // lý do nếu không vui
  understandScore  Int? // 1-5: hiểu bài không — chỉ áp dụng buổi học (type = HOC)
  understandNote   String?      @db.Text // chỗ chưa hiểu
  energyScore      Int // 1-10: năng lượng hôm nay
  difficulty       String?      @db.Text // khó khăn / cần giúp đỡ
  suggestion       String?      @db.Text // góp ý giảng dạy / gắn kết
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([scheduleItemId, userId])
  @@index([scheduleItemId])
  @@map("schedule_feedback")
}


// ── ĐIỂM DANH BUỔI HỌC ────────────────────────────────────────────────
// Danh sách người tham gia lấy từ schedule_access (tài khoản được cấp quyền
// xem lịch) — admin chọn ai tham gia buổi này (hoặc chọn hết = cả team) rồi
// tick có mặt/vắng cho từng người. present = null nghĩa là đã thêm vào danh
// sách tham gia nhưng chưa tick trạng thái.
model ScheduleAttendance {
  id             Int          @id @default(autoincrement())
  scheduleItemId Int
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  present        Boolean?     // null = chưa tick, true = có mặt, false = vắng
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([scheduleItemId, userId])
  @@index([scheduleItemId])
  @@map("schedule_attendance")
}

// ── ĐĂNG KÝ NHẬN PUSH NOTIFICATION (PWA) ─────────────────────────────
// Mỗi thiết bị/trình duyệt cài PWA sẽ tạo 1 bản ghi riêng (1 user có thể có
// nhiều thiết bị). endpoint là duy nhất do trình duyệt cấp cho từng lần
// subscribe, dùng để chống trùng khi subscribe lại (upsert theo endpoint).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscription")
}

// ── HỆ THỐNG CHẤM ĐIỂM HỌC VIÊN ───────────────────────────────────────
// Danh sách lý do do admin tự tạo sẵn (VD: "Đi trễ", "Giúp đỡ bạn học").
// defaultPoints là điểm mặc định gợi ý khi admin áp dụng lý do này cho 1
// học viên (tự động điền sẵn vào form, admin vẫn có thể sửa lại trước khi
// xác nhận). Để trống (null) nếu muốn admin luôn phải tự nhập điểm mỗi lần.
model ScoreReason {
  id            Int               @id @default(autoincrement())
  label         String
  defaultPoints Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  logs          StudentScoreLog[]

  @@map("score_reason")
}

// Mỗi lần admin cộng/trừ điểm cho 1 học viên là 1 bản ghi ở đây — giữ lại
// lịch sử đầy đủ để cả admin và học viên xem lại vì sao điểm thay đổi.
// Điểm hiện tại của 1 học viên = 100 + tổng points của tất cả log của họ.
model StudentScoreLog {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation("StudentScoreLogs", fields: [userId], references: [id], onDelete: Cascade)
  reasonId    Int
  reason      ScoreReason @relation(fields: [reasonId], references: [id])
  points      Int // dương = cộng điểm, âm = trừ điểm (điền sẵn từ defaultPoints, admin có thể sửa)
  note        String?     @db.Text
  createdById Int
  createdBy   User        @relation("ScoreLogCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  // Liên kết tới buổi học nếu điểm này được TỰ ĐỘNG cộng do điểm danh "Có
  // mặt" (không phải admin chấm tay ở trang chấm điểm) — dùng để tránh cộng
  // trùng khi admin lưu lại điểm danh nhiều lần, và để thu hồi điểm nếu sau
  // đó admin sửa lại thành vắng. NULL với các lượt chấm điểm thủ công.
  scheduleItemId Int?
  scheduleItem   ScheduleItem? @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduleItemId])
  @@map("student_score_log")
}